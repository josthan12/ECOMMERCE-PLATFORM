generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

model User {
  id        String    @id @default(cuid())
  clerkId   String    @unique
  email     String    @unique
  name      String?
  role      Role      @default(CUSTOMER)
  addresses Address[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id])
  label      String?
  block      String
  unitNumber String?
  street     String
  postalCode String
  isDefault  Boolean @default(false)
}

enum FieldType {
  TEXT
  RICH_TEXT
  NUMBER
  CURRENCY
  BOOLEAN
  DATE
  DROPDOWN
  CHECKBOX
  RADIO
  IMAGE
  VIDEO
  JSON
  TAG
  COLOR
}

model ProductType {
  id          String         @id @default(cuid())
  name        String         @unique
  slug        String         @unique
  description String?
  fields      ProductField[]
  products    Product[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ProductField {
  id            String      @id @default(cuid())
  productTypeId String
  productType   ProductType @relation(fields: [productTypeId], references: [id], onDelete: Cascade)
  label         String
  key           String
  type          FieldType
  required      Boolean     @default(false)
  options       Json?
  order         Int         @default(0)
  createdAt     DateTime    @default(now())
}

model Product {
  id             String           @id @default(cuid())
  productTypeId  String
  productType    ProductType      @relation(fields: [productTypeId], references: [id])
  name           String
  slug           String           @unique
  description    String?
  attributes     Json
  variantOptions Json?
  imageUrl       String?
  variants       ProductVariant[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  categoryProducts CategoryProduct[]
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  combination Json
  price      Float
  stock      Int      @default(0)
  sku        String?
  imageUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Category {
  id             String   @id @default(cuid())
  name           String   @unique
  slug           String   @unique
  description    String?
  bannerImageUrl String?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products       CategoryProduct[]
}

model CategoryProduct {
  id         String   @id @default(cuid())
  categoryId String
  productId  String

  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([categoryId, productId])
}
